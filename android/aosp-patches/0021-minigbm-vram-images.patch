+ * found in the LICENSE file.
+ */
+
+#ifndef VRAM_IMAGES_H
+#define VRAM_IMAGES_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* One plane in a DMA-BUF of `size` bytes, which the caller owns. */
+struct vram_image {
+	int fd;
+	uint64_t modifier;
+	uint32_t stride;
+	uint32_t offset;
+	uint64_t size;
+};
+
+typedef int (*vram_image_allocator)(uint32_t drm_format, uint32_t width, uint32_t height,
+				    uint64_t limit, struct vram_image *out);
+
+/* An image in VRAM of at most `limit` bytes, cleared. Fails where the Vulkan
+ * driver offers no layout of its own for the format: the buffer then belongs
+ * in system memory.
+ */
+int vram_image_create(uint32_t drm_format, uint32_t width, uint32_t height, uint64_t limit,
+		      struct vram_image *out);
+
+/* CPU access to a VRAM buffer: the buffer's DMA-BUF imports as a Vulkan image
+ * of its own layout, and a linear host-visible copy moves in and out by GPU
+ * copy. The map reports the buffer's own stride, so CPU consumers keep the
+ * layout the handle promised. `map_flags` carries PROT_READ and PROT_WRITE.
+ * `state` holds the staging objects until vram_release; keep it across maps.
+ */
+void *vram_map(int fd, uint64_t modifier, uint32_t drm_format, uint32_t width, uint32_t height,
+	       uint32_t stride, uint64_t size, uint32_t map_flags, void **state);
+
+/* Move CPU writes of a mapped buffer back into VRAM. */
+bool vram_flush(void *state);
+
+/* Re-stage what the GPU drew since the last lock, for read-only maps. */
+void vram_refresh(int key_fd);
+
+/* Drop the staging copy of a buffer whose handle closed. */
+void vram_release_key(int key_fd);
+
+/* Where the DMA-heap image allocator gets VRAM; unset, every image is LINEAR
+ * system memory. The gralloc allocator sets it, which keeps Vulkan out of
+ * libgbm.
+ */
+extern vram_image_allocator dma_heap_image_vram;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
